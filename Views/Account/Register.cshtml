

@{
    ViewData["Title"] = "Register";
}

<!-- Register Section-->
<section class="page-section" id="Login">
    <div class="container">
        <!-- Register Section Heading-->
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Register Account</h2>
        <!-- Icon Divider-->
        <div class="divider-custom">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
            <div class="divider-custom-line"></div>
        </div>
        <!-- Login Section Form-->
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                <form id="Registerform">

                    <div class="form-floating mb-3">
                        <input class="form-control"
                               id="fullname"
                               type="text"
                               placeholder="Enter your full name" />

                        <label for="fullname">Full name</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control"
                               id="tablename"
                               type="text"
                               placeholder="Enter your table name" />

                        <label for="tablename">Table Name</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control"
                               id="username"
                               type="text"
                               placeholder="Enter your username" />

                        <label for="username">Username</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control"
                               id="email"
                               type="email"
                               placeholder="Enter your email" />

                        <label for="email">Email</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control"
                               id="password"
                               type="password"
                               placeholder="Password" />

                        <label for="password">Password</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control"
                               id="confirmpassword"
                               type="password"
                               placeholder="Confirm Password" />

                        <label for="confirmpassword">Confirm Password</label>
                    </div>

                    <button class="btn btn-primary btn-xl" type="submit">
                        Register
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        $(document).ready(function () {

            $("#Registerform").submit(function (e) {
                e.preventDefault();

                $.ajax({
                    url: '@Url.Action("Delete", "Account")',
                    type: "POST",

                    data: {
                        fullname: $("#fullname").val(),
                        tablename: $("#tablename").val(),
                        username: $("#username").val(),
                        email: $("#email").val(),
                        password: $("#password").val()
                    },

                    success: function (response) {
                        alert(response);
                    },

                    error: function (xhr) {
                        alert(
                            "Error: " +
                            xhr.status +
                            "\n" +
                            xhr.responseText
                        );
                    }
                });
            });

        });
    </script>
}